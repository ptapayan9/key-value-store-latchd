# Out-of-source CMake builds, including downloaded dependencies and test results.
/build/
/build-*/
/cmake-build-*/

# Generated files if CMake is accidentally configured in the repository root.
# Keep CMakeLists.txt, CMakePresets.json, and handwritten .cmake files tracked.
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/DartConfiguration.tcl
/Testing/
/Makefile
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log
/_deps/
/latchd
/latch_tests
/latch_tests-*_include.cmake
/latch_tests-*_tests.cmake

# Machine-specific CMake presets and generated clangd compilation database.
/CMakeUserPresets.json
/compile_commands.json

# Language-server caches and editor temporary files.
/.cache/
*.swp
*.swo
*~

# Compiled objects, libraries, executables, and debugging symbols.
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.lib
*.exe
*.pdb
*.dSYM/

# Coverage and profiling output.
*.gcda
*.gcno
*.profraw
*.profdata

# macOS directory metadata.
.DS_Store
