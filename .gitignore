*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.lib
*.exe
*.pdb
*.dSYM/

# Coverage and profiling output.
*.gcda
*.gcno
*.profraw
*.profdata

# macOS directory metadata.
.DS_Store
